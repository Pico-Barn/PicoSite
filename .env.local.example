# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_write_token

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/helpdesk/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/helpdesk/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/helpdesk/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/helpdesk/dashboard

# Supabase (helpdesk tickets + storage)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_SITE_URL=https://pico.it
